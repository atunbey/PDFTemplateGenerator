@page "/dealerinventoryreport"

@using PDFTemplateGenerator.Models
@inject PDFTemplateGenerator.Services.IDealerInventoryReportService dealerReportService;

<h3>Dealer Inventory Report</h3>

<h3>Build Report</h3>

<div class="buttons">
    <button class="btn btn-primary" @onclick="StartBuildingReport">Start Building Report</button>
</div>

@if (vinReport.Vehicles.Count == 0)
{
    <p>NO CARS LOADED</p>
}
else
{
    <p>Cars loaded and report created. Total cars in system is @countCarTotal. Of those cars, @countOnline of those are </p>
    <p>online with pictures. The remaining @countNeedWork vehicles are listed in the system, but are not onine and need work.</p>

    <p>BUILD YOUR WORK LIST</p>

    <InputText
        id="searchBox"
        @bind-Value="searchText"
        @oninput="findVehicle">Search Stock Number

    </InputText>
    //<input id="vehicleSearch" @onkeyup="findVehicle" />

    <select @bind="selectedVehicle" class="form-select" size="5">
        @foreach (var cars in vehicleSearchList)
        {
            <option value="@cars.StockNumber">@cars.Summary</option>
        }
    </select>

    @foreach (var cars in vinReport.Vehicles.Take(10))
    {
        <li>@cars.Summary</li>
    }
}

@code {

    private DealerInventoryReportResult vinReport = new();
    private int countOnline = 0;
    private int countNeedWork = 0;
    private int countCarTotal = 0;
    private string searchText = string.Empty;
    private string selectedVehicle = string.Empty;
    private List<DealerInventoryVehicle> vehicleSearchList = new();

    private Task<IEnumerable<string>> findVehicle(ChangeEventArgs e)
    {
        var searchWith = e.Value?.ToString();
        searchText = searchWith ?? string.Empty;

        if (!string.IsNullOrWhiteSpace(searchWith) && searchWith.Length >= 3)
        {
            var vehicleSearch = vinReport.Vehicles
                .Where(v => v.StockNumber.Contains(searchWith, StringComparison.OrdinalIgnoreCase));

            vehicleSearchList = vehicleSearch.ToList();
            return Task.FromResult(vehicleSearch.Select(v => v.StockNumber));
        }
        else
        {
            vehicleSearchList = new List<DealerInventoryVehicle>();
            return Task.FromResult(Enumerable.Empty<string>());
        }
    }

    private async Task StartBuildingReport()
    {
        var vehicleReport = await dealerReportService.BuildReportAsync();
        countCarTotal = vehicleReport.Vehicles.Count;
        countOnline = vehicleReport.Vehicles.Count(v => v.WebsiteStatus == "Online");
        countNeedWork = vehicleReport.Vehicles.Count(v => v.WebsiteStatus == "Needs Work");
        vinReport = vehicleReport;
    }
}
