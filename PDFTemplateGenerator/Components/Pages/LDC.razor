@page "/ldc"

@using PDFTemplateGenerator.Models
@inject PDFTemplateGenerator.Services.IGristClientService GristClientService
@inject PDFTemplateGenerator.Services.ILegalDocumentService LegalDocumentService

<h3>Legal Document Creator</h3>

<div class="mb-3">
    <label for="clientSearch" class="form-label">Search client</label>
    <InputText
        id="clientSearch"
        class="form-control"
        @bind-Value="_searchText"
        @bind-Value:event="oninput"
        placeholder="Type last, first, or middle name" />
</div>

<div class="mb-3">
    <label for="clientSelect" class="form-label">Select beneficiary</label>
    <select id="clientSelect" class="form-select" @bind="_selectedClientRecordId" size="10">
        <option value="">-- Select a client --</option>
        @foreach (var client in FilteredClients)
        {
            <option value="@client.RecordId">@client.DisplayName (@client.RecordId)</option>
        }
    </select>
    <small class="text-muted">@FilteredClients.Count() result(s)</small>
</div>

<div class="mb-3">
    <label for="templateSelect" class="form-label">Select template</label>
    <select id="templateSelect" class="form-select" @bind="_selectedTemplate">
        <option value="">-- Select a template --</option>
        @foreach (var template in _availableTemplates)
        {
            <option value="@template">@template</option>
        }
    </select>
    @if (!_availableTemplates.Any())
    {
        <small class="text-danger">No .docx templates found from configured source.</small>
    }
</div>

@if (!string.IsNullOrWhiteSpace(_lastOutputPath))
{
    <div class="mb-3">
        <button type="button" class="btn btn-link p-0" @onclick="OpenLastOutputAsync">
            Open generated document
        </button>
    </div>
}

<div class="buttons">
    <button
        class="btn btn-primary bottom-right-fab"
        disabled="@(_isLoadingClients || _isGenerating || string.IsNullOrWhiteSpace(_selectedClientRecordId) || string.IsNullOrEmpty(_selectedTemplate))"
        @onclick="GenerateLegalDocuments">
        Merge Template With Bene
    </button>
</div>

@if (_isLoadingClients)
{
    <p>Loading client list from Grist...</p>
}

@if (!string.IsNullOrWhiteSpace(_status))
{
    <p>@_status</p>
}

@if (!string.IsNullOrWhiteSpace(_lastOutputPath))
{
    <p>@_lastOutputPath</p>
}

@code {

    private string? _status;
    private string? _lastOutputPath;
    private string _searchText = string.Empty;
    private string _selectedClientRecordId = string.Empty;
    private string _selectedTemplate = string.Empty;
    private List<string> _availableTemplates = new();
    private bool _isLoadingClients;
    private bool _isGenerating;
    private List<BeneficiaryClient> _clients = new();

    private IEnumerable<BeneficiaryClient> FilteredClients =>
        string.IsNullOrWhiteSpace(_searchText)
            ? _clients
            : _clients.Where(c =>
                c.DisplayName.Contains(_searchText, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        _isLoadingClients = true;
        _status = "Loading clients...";

        try
        {
            var result = await GristClientService.GetBeneficiariesAsync();
            _clients = result.ToList();
            _status = $"Loaded {_clients.Count} client(s).";
        }
        catch (Exception ex)
        {
            _status = "Unable to load clients from Grist: " + ex.Message;
            _clients = new List<BeneficiaryClient>();
        }
        finally
        {
            _isLoadingClients = false;
        }

            try
            {
                _availableTemplates = (await LegalDocumentService.GetAvailableTemplatesAsync()).ToList();
                if (_availableTemplates.Count == 1)
                    _selectedTemplate = _availableTemplates[0];
            }
            catch (Exception ex)
            {
                _status = "Unable to load template list: " + ex.Message;
                _availableTemplates = new List<string>();
            }
    }

    private async Task GenerateLegalDocuments()
    {
            if (string.IsNullOrWhiteSpace(_selectedClientRecordId))
        {
            _status = "Select a client before generating documents.";
            return;
        }

        _isGenerating = true;
        _lastOutputPath = null;
        _status = "Generating legal document...";

        try
        {
            _lastOutputPath = await LegalDocumentService.GenerateCertificateOfTrustAsync(_selectedClientRecordId, _selectedTemplate);
            _status = "Document generated successfully.";
        }
        catch (Exception ex)
        {
            _status = "Failed to generate document: " + ex.Message;
        }
        finally
        {
            _isGenerating = false;
        }
    }

    private async Task OpenLastOutputAsync()
    {
        if (string.IsNullOrWhiteSpace(_lastOutputPath))
        {
            _status = "No generated document is available to open.";
            return;
        }

        try
        {
            await Launcher.Default.OpenAsync(new OpenFileRequest(
                "Generated Document",
                new ReadOnlyFile(_lastOutputPath)));
        }
        catch (FeatureNotSupportedException)
        {
            _status = "Opening files is not supported on this device.";
        }
        catch (Exception ex)
        {
            try
            {
                await Share.Default.RequestAsync(new ShareFileRequest
                {
                    Title = "Share generated document",
                    File = new ShareFile(_lastOutputPath)
                });
                _status = "No app could open the document directly. Shared instead.";
            }
            catch
            {
                _status = "Unable to open generated document: " + ex.Message;
            }
        }
    }
}
