@inject PDFTemplateGenerator.Services.ICounselSessionService CounselSession
@inject NavigationManager Navigation
@implements IDisposable

<div class="top-row nav-top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand nav-brand" href="" aria-label="Living Equity Home">
            <img src="/images/livingequityprivateministry.jpg" alt="Living Equity logo" class="navbar-brand-logo" />
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler nav-toggle" />

<div class="nav-scrollable nav-scrollable-theme" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column nav-links-theme">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        @if (CounselSession.IsAuthenticated)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="ldc">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Legal Document Creator
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <button type="button" class="nav-link btn btn-link" @onclick="SignOut">
                    <span class="bi bi-box-arrow-right" aria-hidden="true"></span> Sign Out
                </button>
            </div>
        }
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        CounselSession.OnChange += OnSessionChanged;
    }

    private void OnSessionChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void SignOut()
    {
        CounselSession.SignOut();
        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        CounselSession.OnChange -= OnSessionChanged;
    }
}
